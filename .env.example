# Safe template only. Copy to .env and replace placeholders locally.

DJANGO_READ_DOT_ENV_FILE=true
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_ADMIN_URL=admin/
DJANGO_SERVER_EMAIL=admin@localhost
DJANGO_EMAIL_SUBJECT_PREFIX=[InPACE] 
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
DATABASE_URL=sqlite:////tmp/internship_management.sqlite3
POSTGRES_DB=internship_management
POSTGRES_USER=internship_management
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
USE_DOCKER=no
